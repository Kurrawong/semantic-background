PREFIX astatus: <https://linked.data.gov.au/def/reg-statuses/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex: <http://example.com/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://data.kurrawong.ai/sb/examples>
    a schema:DataCatalog ;
    schema:codeRepository "https://github.com/kurrawong/semantic-background" ;
    schema:creator <https://kurrawong.ai> ;
    schema:dateCreated "2026-09-29"^^xsd:date ;
    schema:dateModified "2026-09-30"^^xsd:date ;
    schema:description "A catalogue of example data graphs used by KurrawongAI" ;
    schema:hasPart
        <https://data.kurrawong.ai/sb/examples/idncp-invalid-record> ,
        <https://data.kurrawong.ai/sb/examples/idncp-valid-record> ,
        <https://data.kurrawong.ai/sb/examples/provwf-valid-record> ,
        <https://data.kurrawong.ai/sb/examples/provwf-invalid-record> ,
        <https://data.kurrawong.ai/sb/examples/vocpub-valid-record> ,
        <https://data.kurrawong.ai/sb/examples/vocpub-valid-warnings-record> ,
        <https://data.kurrawong.ai/sb/examples/vocpub-invalid-record> ;
    schema:name "Data graph examples" ;
    schema:publisher <https://kurrawong.ai> ;
    schema:status astatus:experimental ;
    schema:version "1" ;
.

<https://kurrawong.ai> a schema:Organization ;
schema:name "KurrawongAI" ;
schema:url "https://kurrawong.ai"^^xsd:anyURI ;
.

## catalog records

<https://data.kurrawong.ai/sb/examples/addr-v-record> a dcat:CatalogRecord ;
    foaf:primaryTopic <https://data.kurrawong.ai/sb/examples/addr-v> ;
    schema:identifier "44ca90b2dbdf529a85e87daac3a2ca6c" ;
    schema:name "Address model valid example" ;
    sh:suggestedShapesGraph <https://linked.data.gov.au/def/addr/validator> ;
     ex:expectedConformance true .

<https://data.kurrawong.ai/sb/examples/addr-i-record> a dcat:CatalogRecord ;
    foaf:primaryTopic <https://data.kurrawong.ai/sb/examples/addr-i> ;
    schema:identifier "ffdbc21c7b0f27cbd0287980bd1339ad" ;
    schema:name "Address model invalid example" ;
    sh:suggestedShapesGraph <https://linked.data.gov.au/def/addr/validator> ;
     ex:expectedConformance false .

