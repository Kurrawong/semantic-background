PREFIX mrr: <https://prez.dev/ManifestResourceRoles/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX schema: <https://schema.org/>

<https://kurrawong.ai/semantic-background/examples-manifest>
    a prez:Manifest ;
    prof:hasResource 
        [
            prof:hasArtifact "catalogue.ttl" ;
            prof:hasRole mrr:CatalogueData ;
            schema:name "Examples Catalogue" ;
        ] ,
        [
            prof:hasArtifact "items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "Example Resources" ;
        ] ;
.