PREFIX : <https://linked.data.gov.au/def/edes/validator/invertebrate-fauna/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>
PREFIX sg: <https://linked.data.gov.au/def/edes/validator/invertebrate-fauna>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

sg:
    a
        owl:Ontology ,
        sh:ShapesGraph ;
    owl:imports
        sg:-active-sampling-protocol-shapes ,
        sg:-malaise-trapping-protocol-shapes ,
        sg:-rapid-ground-trapping-protocol-shapes ,
        <https://linked.data.gov.au/def/edes/validator/invertebrate-wet-pitfall-protocol-shapes> ;
    schema:contributor <https://kurrawong.ai> ;
    schema:creator <https://linked.data.gov.au/org/tern> ;
    schema:dateCreated "2026-07-31"^^xsd:date ;
    schema:dateModified "2026-08-17"^^xsd:date ;
    schema:description "EDES Invertebrate Fauna Shapes Graph" ;
    schema:name "EDES Invertebrate Fauna Shapes Graph" ;
    schema:publisher <https://linked.data.gov.au/org/tern> ;
    schema:version "2" ;
.
