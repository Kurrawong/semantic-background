:crown-damage-type-result-value
    a
        sh:PropertyShape ,
        <urn:class:Controlled> ,
        <urn:class:Requirement> ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    ns2:status ns2:statusSubmitted ;
    rdfs:isDefinedBy sg: ;
    sh:description "The value in `sosa:hasResult` _MUST_ be a value in `sh:in`, which is the Crown damage types controlled vocabulary." ;
    sh:in (
        <https://linked.data.gov.au/def/nrm/764b44e5-0a06-50fb-ae1d-07b598c0e04d>
        <https://linked.data.gov.au/def/nrm/0a6c2afb-dfeb-56b4-a8ef-b0cd12518e0e>
        <https://linked.data.gov.au/def/nrm/f72b9b89-1d18-56b2-80fd-33dc0bdf9ea9>
    ) ;
    sh:message "The value of `rdf:value` _MUST_ exist in the Crown damage types controlled vocabulary." ;
    sh:name "Result value" ;
    sh:path rdf:value ;
    sh:target
        [
            a sh:SPARQLTarget ;
            sh:select """
        PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
        PREFIX sosa: <http://www.w3.org/ns/sosa/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        select ?this  {
            ?observation a tern:Observation ;
                sosa:observedProperty 
        <https://linked.data.gov.au/def/nrm/c86df5bf-11c4-5382-822b-0f7b3bc0ec75> ;
                sosa:hasResult ?this .
        }""" ;
        ] ;
    ns1:examples _:cb4ac64f6ec977b2f74d5a86b020f6633078a0b04d3191b989b41f50e7782a3403f ;
    ns1:query """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        select ?values {
            values ?categoricalUUID {'41afd1b6-bd4d-5419-b571-931b09b61ce8'}
            ?s skos:member ?values .
            filter (STRENDS(str(?s), ?categoricalUUID))
        }
        """ ;
    ns1:sparqlEndpoint "https://graphdb.tern.org.au/repositories/dawe_vocabs_core" ;
    ns1:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/crown-damage-type/shapes.ttl"^^xsd:anyURI ;
.

:crown-damage-type-simple-result
    a
        sh:NodeShape ,
        <urn:class:Requirement> ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    ns2:status ns2:statusSubmitted ;
    rdfs:isDefinedBy sg: ;
    sh:description "Value of `sosa:hasSimpleResult` _MUST_ be the same as the value in `sosa:hasResult`." ;
    sh:message "The observation's `sosa:hasSimpleResult` _MUST_ have a value that is the same as the value in the value node of `sosa:hasResult`." ;
    sh:name "Simple result" ;
    sh:sparql
        [
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select $this {
        $this a tern:Observation ;
            sosa:observedProperty 
    <https://linked.data.gov.au/def/nrm/c86df5bf-11c4-5382-822b-0f7b3bc0ec75>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
    sh:targetClass <https://w3id.org/tern/ontologies/tern/Observation> ;
    ns1:examples _:cb4ac64f6ec977b2f74d5a86b020f6633078a0b04d3191b989b41f50e7782a3403f ;
    ns1:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/crown-damage-type/shapes.ttl"^^xsd:anyURI ;
.

