:insect-damage-type-result-value
    a
        sh:PropertyShape ,
        <urn:class:Controlled> ,
        <urn:class:Requirement> ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    ns2:status ns2:statusSubmitted ;
    rdfs:isDefinedBy sg: ;
    sh:description "The value in `sosa:hasResult` _MUST_ be a value in `sh:in`, which is the insect damage types controlled vocabulary." ;
    sh:in (
        <https://linked.data.gov.au/def/nrm/68343e94-7b24-4d5b-8a7c-cf52e2914121>
        <https://linked.data.gov.au/def/nrm/1d9a9e7b-6e4e-4b33-a145-663cf8977560>
        <https://linked.data.gov.au/def/nrm/a5c35068-7f44-4e83-b7f5-da311ed81a4d>
        <https://linked.data.gov.au/def/nrm/858d0759-6ec6-4596-933a-c76d45975094>
        <https://linked.data.gov.au/def/nrm/839630da-0816-4333-b06a-f67d37060859>
    ) ;
    sh:message "The value of `rdf:value` _MUST_ exist in the insect damage types controlled vocabulary." ;
    sh:name "Result value" ;
    sh:path rdf:value ;
    sh:target
        [
            a sh:SPARQLTarget ;
            sh:select """
        PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
        PREFIX sosa: <http://www.w3.org/ns/sosa/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        select ?this  {
            ?observation a tern:Observation ;
                sosa:observedProperty 
        <https://linked.data.gov.au/def/nrm/33e79578-0946-4f21-9607-ca501e1500c7> ;
                sosa:hasResult ?this .
        }""" ;
        ] ;
    ns1:examples _:cb2ebe94ac8e7708f3f21a9c4f1e57470d017b7c75126207c9e71c8bbe18fb25822 ;
    ns1:query """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        select ?values {
            values ?categoricalUUID {'ba3f55eb-5698-4974-8101-da346027a346'}
            ?s skos:member ?values .
            filter (STRENDS(str(?s), ?categoricalUUID))
        }
        """ ;
    ns1:sparqlEndpoint "https://graphdb.tern.org.au/repositories/dawe_vocabs_core" ;
    ns1:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/insect-damage-type/shapes.ttl"^^xsd:anyURI ;
.

:insect-damage-type-simple-result
    a
        sh:NodeShape ,
        <urn:class:Requirement> ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    ns2:status ns2:statusSubmitted ;
    rdfs:isDefinedBy sg: ;
    sh:description "Value of `sosa:hasSimpleResult` _MUST_ be the same as the value in `sosa:hasResult`." ;
    sh:message "The observation's `sosa:hasSimpleResult` _MUST_ have a value that is the same as the value in the value node of `sosa:hasResult`." ;
    sh:name "Simple result" ;
    sh:sparql
        [
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select $this {
        $this a tern:Observation ;
            sosa:observedProperty 
    <https://linked.data.gov.au/def/nrm/33e79578-0946-4f21-9607-ca501e1500c7>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
    sh:targetClass <https://w3id.org/tern/ontologies/tern/Observation> ;
    ns1:examples _:cb2ebe94ac8e7708f3f21a9c4f1e57470d017b7c75126207c9e71c8bbe18fb25822 ;
    ns1:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/insect-damage-type/shapes.ttl"^^xsd:anyURI ;
.

