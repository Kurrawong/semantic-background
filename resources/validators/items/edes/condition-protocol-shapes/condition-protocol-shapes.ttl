    ns2:status ns2:statusSubmitted ;
    rdfs:isDefinedBy sg: ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/16a20c3f-e95d-4919-b2d1-a25c7a275109>`.

