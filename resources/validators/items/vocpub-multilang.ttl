    owl:imports <https://linked.data.gov.au/def/vocpub/validator> ;
    owl:versionIRI :5.7 ;
    prof:isProfileOf <https://linked.data.gov.au/def/vocpub/validator> ;
    schema:creator <https://orcid.org/0000-0002-8742-7730> ;
    schema:dateCreated "2020-06-14"^^xsd:date ;
    schema:dateModified "2025-09-22"^^xsd:date ;
    schema:definition "SHACL validator for the VocPub Profile - multi-language variant. This Validator deactivates the standard VocPub shape that mandates just one prefLabel per Concept and requires instead one prefLabel per language."@en ;
    schema:name "VocPub Validator - MultiLang"@en ;
    schema:publisher <https://linked.data.gov.au/org/agldwg> ;
    schema:version "5.8" ;
.

:prefLabel
    a sh:PropertyShape ;
    rdfs:isDefinedBy sg: ;
    sh:message "Requirement 2.1.04, 2.2.1 or 2.3.1 Each vocabulary, Collection or Concept MUST have at least one title and at least one definition indicated using the skos:prefLabel and the skos:definition predicates respectively that must give textual literal values. Only one definition per language is allowed" ;
    sh:minCount 1 ;
    sh:or (
        
        [
            sh:datatype xsd:string ;
        ]
        
        [
            sh:datatype rdf:langString ;
        ]
    ) ;
    sh:path skos:prefLabel ;
    sh:uniqueLang true ;
    schema:name "prefLabel" ;
.

vocpub:prefLabel
    sh:deactivated true ;
.
